# Moonshot AI compatible OpenAI API key
MOONSHOT_API_KEY=replace-with-moonshot-api-key

# iCloud CalDAV credentials
# Use an Apple app-specific password, not your Apple ID password.
ICLOUD_USERNAME=icloud-account@example.invalid
ICLOUD_APP_PASSWORD=replace-with-apple-app-specific-password

# Web app access PIN
ACCESS_PIN=replace-with-access-pin

# Optional: canonical public URL used by Next.js metadata
NEXT_PUBLIC_SITE_URL=https://example.com
